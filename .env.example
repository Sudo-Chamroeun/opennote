# Public HTTPS URL where your reverse proxy (Caddy/Nginx/Traefik) serves this app
HTTPS_URL="https://notes.yourdomain.com"
APP_URL="http://localhost:3000"

# External host port mapped by Docker Compose (maps EXTERNAL_PORT -> container 3000)
EXTERNAL_PORT=3000
PORT=3000

# Security & SQLite storage
JWT_SECRET="replace-with-a-64-char-random-secret"
DATA_DIR="./data"
CORS_ORIGIN="*"

# Super-Admin Console (/opennote-admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-super-admin-password"

# Optional: Free Google Sign-In (OAuth 2.0 Web Client from Google Cloud Console)
# Authorized redirect URI: ${HTTPS_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: SMTP for password reset emails (works with Gmail + Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="opennote <you@gmail.com>"

# Optional: Gemini AI API key if needed in runtime environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"
